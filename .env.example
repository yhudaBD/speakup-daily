# Required for AI chat (RolePlay). Get a key at https://console.groq.com/keys
#
# IMPORTANT: this must be set WITHOUT a VITE_ prefix. Vite inlines every
# VITE_-prefixed variable into the client-side JS bundle, which would ship
# this secret to anyone who opens devtools on the deployed site. The key is
# only ever read server-side, by netlify/functions/groq-proxy.js.
#
# Local dev: `netlify dev` reads this from .env.local automatically.
# Production: set it in the Netlify dashboard under
# Site settings -> Environment variables -> GROQ_API_KEY (not in the repo).
GROQ_API_KEY=your_groq_api_key_here

# Password for the private usage dashboard (public/usage_dashboard.html),
# checked server-side by netlify/functions/get-dashboard-data.js. Pick a long
# random string — anyone with this value can read (not write) aggregated
# usage data for every user. Same rules as GROQ_API_KEY: set it here for
# local dev, and in the Netlify dashboard (not the repo) for production.
ADMIN_SECRET=choose_a_long_random_password

