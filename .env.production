# Loaded only by `vite build` (production mode). Not secret — see .env.example.
#
# This is NOT the <project>.firebaseapp.com value Firebase hands you, and that
# is deliberate. signInWithRedirect delivers its result through a hidden iframe
# served from authDomain; when that is a different origin from the app, browser
# storage partitioning (Chrome 115+, Safari 16.1+, Firefox 109+) gives the
# iframe an empty partitioned bucket, so getRedirectResult resolves to null
# with no error and sign-in silently bounces back to the login screen.
# netlify.toml proxies /__/auth/* to the firebaseapp.com host so this domain
# can serve the auth handler itself, keeping the whole flow same-origin.
# https://firebase.google.com/docs/auth/web/redirect-best-practices
#
# Changing this domain means also adding https://<domain>/__/auth/handler to
# the OAuth client's Authorized redirect URIs in Google Cloud Console, and
# updating the proxy target in netlify.toml.
VITE_FIREBASE_AUTH_DOMAIN=admirable-cassata-5ac5ae.netlify.app
