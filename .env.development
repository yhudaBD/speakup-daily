# Loaded only by `vite` / `netlify dev` (development mode). Not secret.
#
# Production overrides this in .env.production with the site's own domain, to
# keep the sign-in iframe same-origin. That trick can't work locally: the SDK
# builds the iframe URL as `https://${authDomain}/__/auth/iframe` with the
# scheme hardcoded, and the dev server is plain http — so local dev points at
# the firebaseapp.com host and is subject to the same third-party-storage
# limits described in .env.production. Sign-in may therefore fail locally in a
# browser that partitions storage; that is a dev-only limitation, not a
# regression in the deployed app.
VITE_FIREBASE_AUTH_DOMAIN=speakup-daily-88d5a.firebaseapp.com
