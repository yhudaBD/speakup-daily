rules_version = '2';

// The Firebase web config ships in every client bundle (that's expected, it
// isn't a secret), so these rules are the only thing standing between any
// visitor and every account's data. Each signed-in user may read and write
// their own users/{uid} document and anything beneath it (future
// subcollections included), and nothing else. Everything not matched below
// is denied.
//
// Deploy: firebase deploy --only firestore:rules (project in .firebaserc),
// or paste this file into Firebase Console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
